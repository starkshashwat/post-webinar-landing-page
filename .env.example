# ==============================================================================
# MOYA POST-WEBINAR PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port (default 3000 in Coolify/Docker)
PORT=3000

# Razorpay Payment Gateway Credentials (Live or Test)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE

# Razorpay Webhook Secret
# Obtain from Razorpay Dashboard -> Settings -> Webhooks -> Add Webhook:
# Webhook URL: https://vsl.mechanismofya.com/api/razorpay/webhook
# Secret: enter a strong secret or generate one
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE

# GoHighLevel (GHL) Integration Credentials
# Location ID: jsuZqhDRfnfSBFMgdfs2 (MOYA Subaccount)
GHL_LOCATION_ID=jsuZqhDRfnfSBFMgdfs2

# GHL Private Integration Token / API Key
# Obtain from GHL Subaccount Settings -> Business Profile / Private Integrations
GHL_API_KEY=YOUR_GHL_API_KEY_OR_BEARER_TOKEN_HERE

# Optional: GHL Workflow Inbound Webhook URL (if you want to trigger a specific custom webhook directly)
GHL_WEBHOOK_URL=

# Course Offer Pricing (in INR)
COURSE_PRICE=4997

# Fallback Coupon Configuration (Overrides if GHL Custom Values are temporarily offline)
DEFAULT_COUPON_CODE=MOYA55
DEFAULT_COUPON_DISCOUNT=4000
DEFAULT_COUPON_STATUS=ENABLED

